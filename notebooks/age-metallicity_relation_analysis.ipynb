      "53      Pal12       -0.81        8.60 -3.585779\n"
     ]
    }
   ],
   "source": [
    "# Identify outliers based on residuals exceeding 2 times the standard deviation for both datasets.\n",
    "out1 = data[np.abs(data[\"residV\"]) > 2 * sigmaV]\n",
    "out2 = krause[np.abs(krause[\"residK\"]) > 2 * sigmaK]\n",
    "print(out1[[\"Cluster_ID\", \"FeH\", \"Age\", \"residV\"]])\n",
    "print(out2[[\"Cluster_ID\", \"FeH_Krause\", \"Age_Krause\", \"residK\"]])"
   ]
  },
  {
