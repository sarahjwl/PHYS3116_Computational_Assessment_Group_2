    "# Import libraries.\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "data = pd.read_csv(\"globular_clusters_cleaned.csv\")\n",
    "fehlabel = \"[Fe/H] (dex)\"\n",
    "agelabel = \"Age (Gyr)\"\n",
    "data.head()"
   ]
  },
