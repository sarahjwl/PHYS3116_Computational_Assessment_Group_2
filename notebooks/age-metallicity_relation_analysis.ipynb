   "id": "80feb0f1",
   "metadata": {},
   "source": [
    "## Plot 1: VandenBerg et al. (2013)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
